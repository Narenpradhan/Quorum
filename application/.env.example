# ==============================================================================
# Quorum Platform Configuration Template
# Copy this file to .env and modify parameters to fit your environment.
# ==============================================================================

# Database Settings
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quorum

# Redis Cache & Streaming Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_KEY=quorum:vote_stream

# Worker Batching & Persistence Tunables
BATCH_SIZE=50
FLUSH_INTERVAL_SECONDS=2.0

# Application Logging & Observability
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Security & CORS
# Comma-separated allowed origins or * for permissive access
CORS_ORIGINS=*
